# Example environment variables for ai-gateway
# Copy to `.env` and fill in secrets before running locally.

# OpenAI API key (optional for local dev, required for OpenAI features)
OPENAI_API_KEY=
# Google Gemini API key / access token (optional for local dev)
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-2.1
# Server port
PORT=3000

# Node environment
NODE_ENV=development
